<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_custom_invoice_report" model="ir.actions.report">
        <field name="name">Custom Invoice</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">custom_invoice.custom_invoice_report</field>
        <field name="print_report_name">object.name</field>
    </record>

    <template id="custom_external_layout">
        <t t-if="not o" t-set="o" t-value="doc" />

        <t t-if="not company">
            <!-- Multicompany -->
            <t t-if="company_id">
                <t t-set="company" t-value="company_id" />
            </t>
            <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                <t t-set="company" t-value="o.company_id.sudo()" />
            </t>
            <t t-else="else">
                <t t-set="company" t-value="res_company" />
            </t>
        </t>

        <div class="header" dir="rtl" style="margin-top: 10px; font-famil: 'Arial';">
            <div class="row">
                <div class="col-2 text-center"></div>
                <div class="col-8 text-center">
                    <div style="display:flex; flex-direction: column; direction: ltr;">
                        <h5 style="font-weight: bold;">Othman Rashid Al Othman Information Technology Co.</h5>
                        <div style="font-weight: bold;">2nd Floor, Al-Raja Tower, King Abdul Aziz Street., P.O. Box 30052 - Al Khobar</div>
                        <div style="font-weight: bold;">31952, C.R. No. 2051025710</div>
                        <h5>VAT No. : 300450789700003</h5>
                    </div>
                </div>
                <div class="col-2 text-center logo">
                    <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 60px;" alt="Logo"/>
                </div>

            </div>
        </div>
        <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id"
            t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-out="0" />
        </div>
    </template>

</odoo>
