<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">view_partner_form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']/.." position="after">
                <h1>  
                    <label for="company" attrs="{'required' : [('type', '=', 'contact')], 'invisible': [('is_company','=', False)]}"/>
                    <label for="individual" attrs="{'required' : [('type', '=', 'contact')], 'invisible': [('is_company','=', True)]}"/>
                    <field id="company" class="text-break" name="arabic_name" default_focus="1" placeholder="Name in Arabic" attrs="{'required' : [('type', '=', 'contact')], 'invisible': [('is_company','=', False)]}"/>
                    <field id="individual" class="text-break" name="arabic_name" default_focus="1" placeholder="Name in Arabic" attrs="{'required' : [('type', '=', 'contact')], 'invisible': [('is_company','=', True)]}"/>
                </h1>
            </xpath>
            

            
        </field>
    </record>

    <record id="view_partner_form2" model="ir.ui.view">
        <field name="name">view_partner_form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="l10n_sa_edi.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='l10n_sa_additional_identification_scheme']" position="before">
                <!-- <div> -->
                    <field name="street_arabic" placeholder="Street in Arabic..." class="o_address_street" attrs="{'readonly': [('type', '=', 'contact'),('parent_id', '!=', False)]}"/>
                    <field name="street2_arabic" placeholder="Neighbourhood in Arabic..." class="o_address_street" attrs="{'readonly': [('type', '=', 'contact'),('parent_id', '!=', False)]}"/>
                    <field name="city_arabic" placeholder="City in Arabic" class="o_address_city" attrs="{'readonly': [('type', '=', 'contact'),('parent_id', '!=', False)]}"/>
                <!-- </div> -->
                    
            </xpath>
            

            
        </field>
    </record>

</odoo>
